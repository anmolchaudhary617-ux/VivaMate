# Backend Service Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PROJECT_NAME="VivaMate API"

# ==============================================================================
# AI Provider Selection: "ollama" (local) | "huggingface" (production deployment)
# ==============================================================================
AI_PROVIDER=ollama

# ------------------------------------------------------------------------------
# Local Mode Configuration (Ollama + Open-Weight Qwen3 4B)
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b

# ------------------------------------------------------------------------------
# Production Mode Configuration (Hugging Face Inference Providers)
# ------------------------------------------------------------------------------
HF_BASE_URL=https://router.huggingface.co/v1
HF_TOKEN=hf_your_user_access_token_here
HF_MODEL=Qwen/Qwen3-4B-Instruct-2507
